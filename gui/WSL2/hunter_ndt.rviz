Panels:
- Class: rviz/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Accumulated NDT Map1
    - /Live VLP-16 Points1
    - /Hunter NDT Pose (schematic)1
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/Grid
    Enabled: true
    Name: Map XY Grid
    Alpha: 0.35
    Cell Size: 1
    Color: 125; 133; 145
    Line Style:
      Line Width: 0.03
      Value: Lines
    Plane: XY
    Plane Cell Count: 70
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 0.75
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 160; 170; 182
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: Accumulated NDT Map
    Position Transformer: XYZ
    Queue Size: 5
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.02
    Style: Points
    Topic: /ndt_map
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1.0
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 255; 255; 255
    Color Transformer: AxisColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: Live VLP-16 Points
    Position Transformer: XYZ
    Queue Size: 5
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.02
    Style: Points
    Topic: /velodyne_points
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz/MarkerArray
    Enabled: true
    Name: Hunter NDT Pose (schematic)
    Marker Topic: /hunter_viz/robot_markers
    Queue Size: 10
    Namespaces: {}
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz/Path
    Color: 255; 213; 70
    Enabled: true
    Head Diameter: 0.25
    Head Length: 0.2
    Length: 0.2
    Line Style: Lines
    Line Width: 0.04
    Name: Hunter NDT Trajectory
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 213; 70
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic: /hunter_viz/path
    Value: true
  - Alpha: 1
    Axes Length: 1
    Axes Radius: 0.1
    Class: rviz/Pose
    Color: 240; 192; 25
    Enabled: true
    Head Length: 0.38
    Head Radius: 0.18
    Name: NDT Current Pose
    Shaft Length: 0.75
    Shaft Radius: 0.08
    Shape: Arrow
    Topic: /current_pose
    Value: true
  - Class: rviz/Axes
    Enabled: true
    Length: 1.5
    Name: base_link Axes
    Radius: 0.1
    Reference Frame: base_link
    Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 44; 52
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 27
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Target Frame: <Fixed Frame>
      Yaw: 0.4
    Saved: null
